{
    :paths ["src"]
    :deps {
        org.flatland/ordered {:mvn/version "1.15.12"}
        reagent/reagent {:mvn/version "2.0.1"}
        re-frame/re-frame {:mvn/version "1.4.7"}
        day8.re-frame/tracing {:mvn/version "0.9.2"} ; -- needed for re-frame-10x
        day8.re-frame/re-frame-10x {:mvn/version "1.12.3"}
        day8.re-frame/http-fx {:mvn/version "0.2.4"}
        re-com/re-com {:mvn/version "2.29.3"}
        com.andrewmcveigh/cljs-time {:mvn/version "0.5.2"}

        dev.weavejester/medley {:mvn/version "1.10.0"}
        instaparse/instaparse {:mvn/version "1.5.0"}
        thheller/shadow-cljs {:mvn/version "3.4.11"}
        ;; Request a newer version so as to avoid known critical 
        ;; vulnerabilities. See also 
        ;; https://github.com/thheller/shadow-undertow/issues/3.
        io.undertow/undertow-core {:mvn/version "2.4.1.Final"}
        com.rpl/specter {:mvn/version "1.1.6"}
    }
   
    :aliases {
        :cljs {
            :extra-deps {
                binaryage/devtools {:mvn/version "1.0.7"}
            }}
        :dev {
            :extra-deps {
                binaryage/devtools {:mvn/version "1.0.7"}
                thheller/shadow-cljs {:mvn/version "3.4.11"
                                      }
                }
        }
        :backend {
            :extra-deps {
                compojure/compojure {:mvn/version "1.7.2"}
                ring/ring-core {:mvn/version "1.15.4"}
                ring/ring-jetty-adapter {:mvn/version "1.15.4"}
                metosin/jsonista {:mvn/version "1.0.0"}
                org.clojure/tools.logging {:mvn/version "1.3.1"}
                ring-logger/ring-logger {:mvn/version "1.1.1"}
                yogthos/config {:mvn/version "1.2.1"}
                ;; FIXME Only for development.
                ring/ring-devel {:mvn/version "1.15.4"}
                cider/cider-nrepl {:mvn/version "0.59.0"}
            }
            :main-opts ["-m" "backend.core"]
        }
        :outdated {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}}
                   :main-opts ["-m" "antq.core"]}

    }
}
